---
profile: basic
offline: true

# Solo VPS intentionally uses one project-wide solo_vps_* variable namespace across
# roles. Keep every other var-naming check, but do not require role_name_* prefixes.
skip_list:
  - var-naming[no-role-prefix]

exclude_paths:
  - legacy/
  - .venv/
  # Data loaded via vars_files by the four evaluation playbooks, not a playbook.
  - ansible/playbooks/coolify-4.3.21-evaluation-vars.yml
