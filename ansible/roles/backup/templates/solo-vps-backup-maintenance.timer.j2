[Unit]
Description=Run Solo VPS restic retention maintenance weekly

[Timer]
OnCalendar={{ solo_vps_backup_maintenance_timer_on_calendar }}
RandomizedDelaySec={{ solo_vps_backup_maintenance_timer_randomized_delay }}
Persistent=true
AccuracySec=1m
Unit=solo-vps-backup-maintenance.service

[Install]
WantedBy=timers.target
