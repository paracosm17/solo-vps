// Managed by Solo VPS. Local edits will be replaced by Ansible.
// Clear inherited origin lists before representing the supported Ubuntu policy.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
{% for origin in solo_vps_updates_allowed_origins %}
    "{{ origin }}";
{% endfor %}
};

// A single-VPS platform must not reboot itself without an operator decision.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";
