// Managed by Solo VPS. Application logs only; host metrics are configured separately.
logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "coolify" {
  host             = "{{ solo_vps_alloy_docker_host }}"
  refresh_interval = "15s"

  filter {
    name   = "label"
    values = ["coolify.managed=true"]
  }
}

discovery.relabel "coolify_logs" {
  targets = discovery.docker.coolify.targets

  rule {
    source_labels = ["__meta_docker_container_label_coolify_type"]
    regex         = "(application|service)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_coolify_serviceName"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_coolify_projectName"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_coolify_environmentName"]
    target_label  = "environment"
  }

  rule {
    source_labels = ["__meta_docker_container_label_coolify_type"]
    target_label  = "coolify_type"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "component"
  }

  rule {
    target_label = "job"
    replacement  = "solo-vps"
  }
}

loki.source.docker "coolify" {
  host             = "{{ solo_vps_alloy_docker_host }}"
  targets          = discovery.relabel.coolify_logs.output
  labels           = { source = "docker" }
  refresh_interval = "15s"
  forward_to       = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
